# ==============================================================================
# Sharda Dinings — Backend & Frontend Environment Example
# Copy this file to `.env` for local configuration. Never commit `.env`.
# ==============================================================================

# --- Server & Data Driver ---
NODE_ENV=development
PORT=5000

# Data driver: "mock" (default, in-memory demo data) or "mongo" (live MongoDB)
DATA_DRIVER=mock

# MongoDB connection string (required only when DATA_DRIVER=mongo)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sharda_dinings
MONGODB_URI=

# --- Frontend & CORS ---
# Comma-separated list of allowed frontend origins (used in production/staging)
FRONTEND_URL=http://localhost:3000

# Vite frontend API base URL (optional; defaults to http://localhost:5000/api/v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Admin Authentication (Protected Admin API Foundation) ---
# Generate a strong random secret (at least 32 chars) before enabling admin login
JWT_SECRET=
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=
# Store a bcrypt hash here (do not store plaintext passwords)
ADMIN_PASSWORD_HASH=

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_SUBMISSIONS=20

# --- Future External Integrations (Unconnected Placeholders) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER_KEY=
PAYMENT_GATEWAY_KEY=
PAYMENT_WEBHOOK_SECRET=
